:Silo:sHydrator:Registry:v1

/**
 * Master entry point for the NATVS Hydration Engine configuration.
 * A file can selectively choose to instantiate one or more blocks.
 */
HydratorConfig = [ RegistryBlock ] [ HarnessBlock ] [ AuthorityBlock ] ;

/**
 * The Centralized Registry mapping coordinates to physical folders.
 * Used strictly inside sforge_paths_hydrator.webnf.
 */
RegistryBlock = "logical_paths" "{" { RegistryEntry } "}" ;

/**
 * A single logical mapping entry matching coordinates to an absolute path.
 */
RegistryEntry = RealmKind "_" OriginKind "_" CategoryKind "=" SForgePhysicalPath ";" ;

/**
 * The authority boundary: platform core, optional products, or customer solutions.
 */
RealmKind = "PLATFORM_CORE"
          / "PLATFORM_PRODUCT"
          / "LICENSEE_CUSTOM"
          ;

/**
 * The IP boundary: external adaptations versus internal proprietary IP.
 */
OriginKind = "EXTERNAL"
           / "INTERNAL"
           ;

/**
 * The standard structural categories shared identically across all realms.
 */
CategoryKind = "BLUEPRINT"
             / "TOOLCHAIN"
             / "EPHEMERAL"
             / "ACTOR"
             ;

/**
 * Universal Filepath (LLM-optimized, cross-platform invariant using forward slashes).
 * Ex: "C:/aCogSpaceSeed/00FLOW/sForge"
 */
UniversalPath = String ;

/**
 * An absolute filesystem path matching the workspace host OS structure.
 * This rule acts as a declarative transition target from UniversalPath to native OS path.
 */
SForgePhysicalPath = UniversalPath "->" "HostPlatformPath" ;

/**
 * The localized workspace harness defining Dynamic and Static hydration targets.
 * Used strictly inside local workspace_hydrator.webnf files.
 */
HarnessBlock = "workspace_harness" "{" WorkspaceName [ HydrationTargets ] PromotionCoords "}" ;

/**
 * The unique identifier for the containing workspace.
 */
WorkspaceName = "name" ":" String ";" ;

/**
 * Group of hydration targets defined in the workspace.
 */
HydrationTargets = "targets" "{" { HydrationTarget } "}" ;

/**
 * A single execution block representing compiled synthesis or static ingestion.
 */
HydrationTarget = "target" "{" HydrationMode HydrationEngine SourcePath OutputName "}" ;

/**
 * Execution modality: dynamic compiler compilation versus static mirror download.
 */
HydrationMode = "mode" ":" ( "DYNAMIC" / "STATIC" ) ";" ;

/**
 * The target compiler toolchain or retrieval tool driving the build.
 */
HydrationEngine = "engine" ":" String ";" ;

/**
 * The local path containing the target source code.
 */
SourcePath = "src" ":" String ";" ;

/**
 * The target output binary or blueprint filename.
 */
OutputName = "out" ":" String ";" ;

/**
 * Logical target coordinates where the completed artifacts will be promoted.
 */
PromotionCoords = "promote" "{" 
                  "realm" ":" RealmKind ";"
                  "origin" ":" OriginKind ";"
                  "category" ":" CategoryKind ";"
                  "}" ;

/**
 * The authority block defining cryptographic roots and static mirrors.
 * Used strictly inside authority_blueprints_hydrator.webnf.
 */
AuthorityBlock = "authority_blueprints" "{" [ SecurityRoots ] [ StaticBlueprints ] "}" ;

/**
 * Trusted platform authority cryptographic keys for checking seals.
 */
SecurityRoots = "security_roots" "{" { KeyEntry } "}" ;

/**
 * A single trusted signature entry mapping a key ID to its raw bytes.
 */
KeyEntry = "key" ":" String "signature" ":" String ";" ;

/**
 * Manifest definitions for declarative toolchain and blueprint ingestion.
 */
StaticBlueprints = "static_blueprints" "{" { BlueprintEntry } "}" ;

/**
 * An individual mirror package configuration containing its target path and seal.
 */
BlueprintEntry = "blueprint" "{" 
                 "target_path" ":" SForgePhysicalPath ";"
                 "download_url" ":" String ";"
                 "sha256" ":" String ";"
                 "veracity_seal" ":" String ";"
                 "}" ;

# aCogSpaceSeed Root Gitignore

# Hollow Silos (Managed as separate repositories, keeping directory structure)
/000ALL/*
!/000ALL/.gitkeep
/00FLOW/*
!/00FLOW/.gitkeep
/86SREF/*
!/86SREF/.gitkeep
/00AAIF/*
!/00AAIF/.gitkeep

# Other managed directories
/.agents/
/.gemini/

# Ephemeral Scratch
/C0990-ephemeral-scratch/*
!/C0990-ephemeral-scratch/.gitkeep

# The following are fully tracked in the Root Repo:
# - conductor/
# - go.work
# - go.work.sum
# - AGENTS.md
# - .gitroot

; Declarative Workspace Harness
; Governed by hydrator.wag

workspace_harness {
    name : "s-hydration" ;
    targets {
        target {
            mode : DYNAMIC ;
            engine : "go-compiler" ;
            src : "s-hydration" ;
            out : "s-hydration" ;
            category : "TOOLCHAIN" ;
        }
    }
    promote {
        realm : PLATFORM ;
        origin : INTERNAL ;
        category : TOOLCHAIN ;
    }
}

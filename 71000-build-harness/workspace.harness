; Declarative Workspace Harness
; Governed by hydrator.wag

workspace_harness {
    name : "s-hydration" ;
    test_enabled:true;
    targets {
        target {
            mode : DYNAMIC ;
            engine : "go-compiler" ;
            src : "cmd/ext-rehydrator" ;
            out : "ext-rehydrator" ;
            category : "TOOLCHAIN" ;
        }
        target {
            mode : DYNAMIC ;
            engine : "go-compiler" ;
            src : "cmd/int-rehydrator" ;
            out : "int-rehydrator" ;
            category : "TOOLCHAIN" ;
        }
        target {
            mode : DYNAMIC ;
            engine : "go-compiler" ;
            src : "cmd/mod-aligner" ;
            out : "mod-aligner" ;
            category : "TOOLCHAIN" ;
        }
    }
    promote {
        realm : PLATFORM ;
        origin : INTERNAL ;
        category : TOOLCHAIN ;
    }
}

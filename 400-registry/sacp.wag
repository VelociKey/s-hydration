:Silo:sHydration:SACP:v1

/**
 * Master entry point for the Sovereign Agentic Context Protocol (SACP).
 */
SACPMessage = [ QAPCHeaderBlock ] [ CapabilityFrameBlock ] ;

/**
 * The high-assurance qAPC Security Header enforcing Monotonic Authority.
 */
QAPCHeaderBlock = "qapc_header" "{" 
                  "session_id" ":" String ";"
                  "original_authority" ":" AuthorityLevel ";"
                  "current_authority" ":" AuthorityLevel ";"
                  { AttestationBlock }
                  "}" ;

/**
 * Monotonic permission levels coordinating agent capabilities.
 */
AuthorityLevel = "AuthSovereign"
               / "AuthManager"
               / "AuthWorker"
               / "AuthGuest"
               ;

/**
 * Attestation block generated by Zero-Knowledge or hardware platform roots.
 */
AttestationBlock = "attestation" "{" 
                   "type" ":" AttestationType ";"
                   "payload" ":" String ";"
                   "}" ;

AttestationType = "TPM_QUOTE"
                / "SPIFFE_SVID"
                / "VERACITY_SEAL"
                ;

/**
 * Pluggable domain specific capability frame.
 */
CapabilityFrameBlock = "capability_frame" "{"
                       "domain" ":" DomainKind ";"
                       "action" ":" ActionKind ";"
                       "id" ":" String ";"
                       [ ParametersBlock ]
                       "}" ;

DomainKind = "resource"
           / "tool"
           / "prompt"
           ;

ActionKind = "register"
           / "discover"
           / "call"
           ;

ParametersBlock = "parameters" "{" { ParameterEntry } "}" ;

ParameterEntry = String "=" String ";" ;

#!/bin/sh
#
# /etc/init.d/S99hermes-bridge
# Startup script to bridge guest vsock/socat traffic to host SACP broker UDP port 9099.
#

case "$1" in
    start)
        echo "Starting sandboxed Firecracker vsock-to-UDP SACP bridge..."
        
        # 1. Start the compiled Go-based guest Hermes agent in the background
        /app/hermes_agent --secure --sacp-route &
        
        # 2. Spawn the socat bridge mapping guest vsock CID 3 port 1000 to guest loopback UDP 9099
        # (This UDP port 9099 will then be routed directly to the host's SACPBroker UDP server)
        socat VSOCK-LISTEN:1000,fork UDP4:127.0.0.1:9099 &
        
        echo "SACP Guest-to-Host bridge active on VSOCK port 1000 -> loopback UDP 9099"
        ;;
    stop)
        echo "Stopping SACP bridge..."
        killall socat
        killall hermes_agent
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
